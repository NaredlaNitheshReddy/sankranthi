# --- Dart / Flutter ---
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
pubspec_overrides.yaml
doc/api/

# --- Config / secrets (constraint #6, REQUIREMENTS §60) ---
# Real config is injected with --dart-define-from-file and never committed.
config/*.json
!config/*.example.json

# --- Android ---
android/.gradle/
android/.kotlin/
android/captures/
android/local.properties
android/key.properties
android/app/*.jks
android/app/*.keystore
*.apk
*.aab
*.apks

# --- iOS (no iOS target; these are generated anyway) ---
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/

# --- Tests ---
coverage/
# Golden mismatch output, not source
test/**/failures/

# --- IDE ---
.idea/
.vscode/
*.swp
*~

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
