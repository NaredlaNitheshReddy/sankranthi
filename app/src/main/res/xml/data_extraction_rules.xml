<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12 and higher.
     https://developer.android.com/about/versions/12/backup-restore

     See backup_rules.xml: the encrypted credential is excluded from both cloud
     backup and direct device transfer, because its Keystore key stays behind. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/sankranthi_credentials.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/sankranthi_credentials.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
